# BambuStudio variant of orca-slicer-api.
#
# Same Node wrapper code as the OrcaSlicer image — the wrapper is
# slicer-agnostic, it just shells out to whatever binary `ORCASLICER_PATH`
# points at via `--load-settings` / `--slice` (which BambuStudio's CLI
# accepts identically). Only the bundled AppImage differs.
#
# Build:
#   docker build -f Dockerfile.bambu-studio --build-arg BAMBU_VERSION=02.09.01.70 \
#                -t ghcr.io/maziggy/bambu-studio-api:latest .
#
# AMD64 only — BambuStudio doesn't publish an official ARM64 AppImage.
#
# Switched from the Fedora AppImage to the Ubuntu 22.04 AppImage in 2026-06
# because BambuStudio dropped the Fedora variant starting v02.07.x; only
# `BambuStudio_ubuntu-22.04-*` and `BambuStudio_ubuntu-24.04-*` are now
# published. We pin to 22.04 because the runtime image below (22.04) ships
# webkit2gtk-4.0, the API BambuStudio links against; 24.04 only has 4.1.
#
# The Ubuntu AppImage filename embeds an opaque build timestamp
# (e.g. `BambuStudio_ubu22_v02.09.01.70-20261103183404.AppImage`; before
# 02.09 the prefix was `BambuStudio_ubuntu-22.04-` / `BambuStudio_ubuntu22.04-`)
# that can't be derived from BAMBU_VERSION alone, so we resolve the asset
# URL at build time via the GitHub releases API. One unauthenticated call
# per build; the public rate limit (60/hr per IP) is fine in practice.

FROM node:22-bookworm AS build

ARG BAMBU_VERSION=02.09.01.70
ARG TARGETARCH

WORKDIR /app

# set -e: a failed download or extraction stops this step instead of
# surfacing later as a missing slicer. GitHub answers 504 at times.
RUN set -e; \
    if [ "$TARGETARCH" = "arm64" ]; then \
        echo "ARM64 not supported — BambuStudio has no official ARM64 AppImage."; \
        exit 1; \
    fi; \
    echo "Resolving BambuStudio v${BAMBU_VERSION} Ubuntu 22.04 AppImage URL..."; \
    BAMBU_URL=$(curl -fsSL --retry 5 --retry-all-errors --retry-delay 10 "https://api.github.com/repos/bambulab/BambuStudio/releases/tags/v${BAMBU_VERSION}" \
        | grep -oE 'https://[^"]*BambuStudio_ubu(ntu)?-?22(\.04)?[-_][^"]*\.AppImage' \
        | head -1); \
    if [ -z "$BAMBU_URL" ]; then \
        echo "ERROR: No Ubuntu 22.04 AppImage asset found in BambuStudio v${BAMBU_VERSION}." >&2; \
        echo "Check that the release exists and ships the ubuntu-22.04 variant." >&2; \
        exit 1; \
    fi; \
    echo "Downloading $BAMBU_URL"; \
    curl -fL --retry 5 --retry-all-errors --retry-delay 10 -o bambu.AppImage "$BAMBU_URL"; \
    chmod +x bambu.AppImage; \
    ./bambu.AppImage --appimage-extract > /dev/null; \
    rm bambu.AppImage; \
    if [ ! -x squashfs-root/AppRun ]; then \
        echo "ERROR: the extracted AppImage has no AppRun" >&2; \
        exit 1; \
    fi

COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM ubuntu:22.04

# webkit2gtk-4.1 is the right ABI line. BambuStudio's "ubuntu-22.04" AppImage
# variant dynamically links against `libwebkit2gtk-4.1.so.0` starting with
# v02.07.x — earlier 02.06.x builds linked against 4.0 (which is why the
# install line here used to ship libwebkit2gtk-4.0-37). Both 22.04 and 24.04
# ship 4.1 in-archive, so we can stay on 22.04 — keeps the glibc target the
# AppImage was built against.
#
# Symptom of getting this wrong: the CLI exits 127 at startup with
# `error while loading shared libraries: libwebkit2gtk-4.1.so.0`, every
# `/slice` call returns 500, and Bambuddy's preview-slice falls through
# to "all filaments required" in the SliceModal.
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
       curl ca-certificates gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       nodejs \
       libgl1 libgl1-mesa-dri libegl1 libopengl0 libglu1-mesa libosmesa6 \
       libsm6 libice6 libmspack0 libsoup2.4-1 \
       libgtk-3-0 \
       libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
       libwebkit2gtk-4.1-0 \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/dist/src /app/dist
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/squashfs-root /app/squashfs-root

ENV PORT=3000
# `ORCASLICER_PATH` is the wrapper's slicer-binary env var, regardless of
# which slicer is bundled. Point it at the extracted BambuStudio AppRun.
ENV ORCASLICER_PATH=/app/squashfs-root/AppRun
ENV DATA_PATH=/app/data
ENV NODE_ENV=production
# Which slicer this image wraps. The wrapper itself is slicer-agnostic;
# tests use this to skip coverage that only applies to one of them.
ENV SLICER_FLAVOR=bambu
# Bundled BBL profiles live under the same path inside BambuStudio.
ENV BUNDLED_PROFILES_PATH=/app/squashfs-root/resources/profiles/BBL

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

CMD ["node", "app/dist/index.js"]

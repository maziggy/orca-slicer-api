# BambuStudio variant of the e2e test image.
#
# Same Node + AppImage layout as Dockerfile.test, but pulls the
# BambuStudio AppImage so the bundle e2e tests
# (tests/e2e/slice-with-bundle.spec.ts) can resolve `inherits:` chains
# against BambuStudio's BBL profile set — the test fixture
# (tests/files/input/H2D-bundle.bbscfg) inherits from "Bambu Lab H2D
# 0.4 nozzle", a system preset OrcaSlicer 2.3.x doesn't ship.
#
# Build:
#   docker build -f tests/docker/Dockerfile.test.bambu-studio \
#                --build-arg BAMBU_VERSION=02.09.01.70 \
#                -t bambu-studio-api-test .
#   docker run --rm bambu-studio-api-test
#
# AMD64 only — BambuStudio doesn't publish an official ARM64 AppImage.
# Uses the Ubuntu 22.04 AppImage (Fedora was dropped upstream after
# v02.06.x); see Dockerfile.bambu-studio for the asset-resolution rationale.

FROM ubuntu:22.04

ARG BAMBU_VERSION=02.09.01.70
ARG TARGETARCH

WORKDIR /app

RUN if [ "$TARGETARCH" = "arm64" ]; then \
        echo "ARM64 not supported — BambuStudio has no official ARM64 AppImage."; \
        exit 1; \
    fi

# BambuStudio's "ubuntu-22.04" AppImage variant links against webkit2gtk-4.1
# starting with v02.07.x (was 4.0 in 02.06.x); both 22.04 and 24.04 ship 4.1
# in-archive, so we stay on 22.04 here. See Dockerfile.bambu-studio for the
# full failure mode if the wrong webkit2gtk family is installed.
RUN apt-get update \
	&& apt-get upgrade -y \
	&& apt-get install -y --no-install-recommends \
	curl ca-certificates gnupg \
	&& mkdir -p /etc/apt/keyrings \
	&& curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
	&& echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
	&& apt-get update \
	&& apt-get install -y --no-install-recommends \
	nodejs \
	libgl1 libgl1-mesa-dri libegl1 libopengl0 libglu1-mesa libosmesa6 \
	libsm6 libice6 libmspack0 libsoup2.4-1 \
	libgtk-3-0 \
	libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
	libwebkit2gtk-4.1-0 \
	&& update-ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

RUN echo "Resolving BambuStudio v${BAMBU_VERSION} Ubuntu 22.04 AppImage URL..."; \
	BAMBU_URL=$(curl -fsSL "https://api.github.com/repos/bambulab/BambuStudio/releases/tags/v${BAMBU_VERSION}" \
		| grep -oE 'https://[^"]*BambuStudio_ubu(ntu)?-?22(\.04)?[-_][^"]*\.AppImage' \
		| head -1); \
	if [ -z "$BAMBU_URL" ]; then \
		echo "ERROR: No Ubuntu 22.04 AppImage in BambuStudio v${BAMBU_VERSION}." >&2; \
		exit 1; \
	fi; \
	echo "Downloading $BAMBU_URL"; \
	curl -fL -o bambu.AppImage "$BAMBU_URL"; \
	chmod +x bambu.AppImage; \
	./bambu.AppImage --appimage-extract; \
	rm bambu.AppImage

COPY package*.json ./

RUN npm ci

COPY . .
COPY tests ./

ENV PORT=3000
# `ORCASLICER_PATH` is the slicer-agnostic env var the wrapper reads at
# spawn time; the binary it points at is BambuStudio in this image.
ENV ORCASLICER_PATH=/app/squashfs-root/AppRun
ENV BUNDLED_PROFILES_PATH=/app/squashfs-root/resources/profiles/BBL
ENV NODE_ENV=test
# Which slicer this image wraps. The wrapper itself is slicer-agnostic;
# tests use this to skip coverage that only applies to one of them.
ENV SLICER_FLAVOR=bambu
ENV DATA_PATH=/tmp/data
ENV OUTPUT_PATH=/tmp/output

RUN mkdir -p /tmp/data /tmp/output

CMD ["npm", "run", "test:e2e"]
